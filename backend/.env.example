NODE_ENV=development
PORT=3001

# Configure either DATABASE_URL or the DB_* fields below.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=projectflow
DB_USER=postgres
DB_PASSWORD=change-me
DB_SSL=false
# Keep true in production; false only skips certificate verification.
DB_SSL_REJECT_UNAUTHORIZED=true
# Download the Supabase root certificate and set its path relative to backend/.
DB_SSL_CA_PATH=
# Supabase pooler URLs on port 5432 are automatically switched to 6543 (transaction mode).
# Set DB_FORCE_SESSION_POOLER=true to keep 5432. Keep the pool small on serverless.
DB_POOL_MAX=2
DB_FORCE_SESSION_POOLER=false

SESSION_SECRET=replace-with-at-least-32-random-characters
FRONTEND_URL=http://localhost:5173

MESSAGE_CENTRAL_SEND_OTP_URL=https://cpaas.messagecentral.com/verification/v3/send
MESSAGE_CENTRAL_VALIDATE_OTP_URL=https://cpaas.messagecentral.com/verification/v3/validateOtp
MESSAGE_CENTRAL_CUSTOMER_ID=
MESSAGE_CENTRAL_AUTH_TOKEN=
MESSAGE_CENTRAL_COUNTRY_CODE=91

BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_API_KEY=
BUNNY_CDN_URL=
BUNNY_STORAGE_REGION=
PRIVATE_FILE_DIRECTORY=
PRIVATE_FILE_MAX_BYTES=5242880

# Gmail SMTP. Use a Google App Password, not your Google account password.
# EMAIL_FROM may be left blank; EMAIL_USER is used as the sender then.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=annotrai.help@gmail.com
EMAIL_PASSWORD=replace-with-16-character-google-app-password
EMAIL_FROM="Annotra AI <annotrai.help@gmail.com>"

# Development-only account login bypass. Never enable with NODE_ENV=production.
DEV_AUTH_ENABLED=false
