{
  "name": "projectflow",
  "version": "1.0.0",
  "private": true,
  "description": "Project and annotator workforce management",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "build": "npm run build --prefix frontend",
    "start": "npm run start --prefix backend",
    "db:seed": "npm run seed --prefix backend",
    "db:migrate": "npm run db:migrate --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
