BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_API_KEY=
BUNNY_CDN_URL=
BUNNY_STORAGE_REGION=
PRIVATE_FILE_DIRECTORY=
PRIVATE_FILE_MAX_BYTES=5242880

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
