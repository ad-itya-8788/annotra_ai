NODE_ENV=development
PORT=3001

# Configure either DATABASE_URL or the DB_* fields below.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=projectflow
DB_USER=postgres
DB_PASSWORD=change-me
DB_SSL=false

SESSION_SECRET=replace-with-at-least-32-random-characters
FRONTEND_URL=http://localhost:5173

MESSAGECENTRAL_BASE_URL=https://cpaas.messagecentral.com
MESSAGECENTRAL_SEND_OTP_URL=https://cpaas.messagecentral.com/verification/v3/send
MESSAGECENTRAL_VALIDATE_OTP_URL=https://cpaas.messagecentral.com/verification/v3/validateOtp
MESSAGECENTRAL_CUSTOMER_ID=
MESSAGECENTRAL_API_KEY=
